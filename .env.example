# -- HTTP server
API_PORT=8200
API_READ_HEADER_TIMEOUT=5s
API_READ_TIMEOUT=15s
API_WRITE_TIMEOUT=15s
API_IDLE_TIMEOUT=60s

# -- Authentication
# Replace with a random secret containing at least 32 bytes.
JWT_SECRET=change-me-use-at-least-32-random-bytes

# -- PostgreSQL database
POSTGRES_USER=admin
POSTGRES_PASSWORD=4321
POSTGRES_DB=database
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_MAX_OPEN_CONNS=10
POSTGRES_MAX_IDLE_CONNS=2
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONN_MAX_IDLE_TIME=5m

# -- Atlas migrations (local CLI connects through the published Docker port)
ATLAS_DATABASE_URL="postgres://admin:4321@localhost:5810/database?sslmode=disable&search_path=public"

# -- OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=go-todo-service
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_COLLECTOR_INSECURE=true
OTEL_SHUTDOWN_TIMEOUT=5s
OTEL_TRACER_RATIO=1.0
